# Copy this file to .env and add your server-only OpenAI API key.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
PORT=3000

# For secure Firebase login checks on the AI API, download a Firebase Admin SDK
# service-account JSON key and save it as service-account.json in this project root.
# Keep that file private; it is ignored by Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
